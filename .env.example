# ═══════════════════════════════════════════════════════════
#  IRon-Gate — نمونهٔ تنظیمات
#  این فایل رو به .env کپی کن و مقادیر رو پر کن:
#      cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── تلگرام ──────────────────────────────────
# از https://my.telegram.org بگیر
API_ID=your_api_id
API_HASH=your_api_hash

# از @BotFather بگیر
BOT_TOKEN=your_bot_token

# اختیاری: اگر تنظیم بشه فقط این کاربر می‌تونه ازت استفاده کنه (توصیه می‌شه)
OWNER_TELEGRAM_ID=

# ─── روبیکا ──────────────────────────────────
# نام فایل session روبیکا (پیشفرض rubsession)
# ⚠️ این فایل بعد از لاگین حاوی توکن ورود توئه — هرگز commit نکن!
RUBIKA_SESSION=rubsession

# ─── دانلودر گوگل پلی ─────────────────────────
# معماری خروجی APK:
#   universal → روی همهٔ گوشی‌ها نصب می‌شه (پیشفرض، دو بار دانلود، فایل بزرگ‌تر)
#   arm64     → گوشی‌های مدرن ۶۴ بیتی (۲۰۱۶+)
#   armv7     → گوشی‌های قدیمی ۳۲ بیتی
PLAY_ARCH=universal

# پوشه موقت برای فایل‌های دانلودشده
DOWNLOAD_DIR=downloads

# مسیر APKEditor.jar (اتوماتیک دانلود می‌شه اگه نبود)
APKEDITOR_JAR=tools/APKEditor.jar

# ─── بهینه‌سازی سرعت آپلود روبیکا ──────────────
# اندازهٔ هر چانک آپلود بر حسب بایت (پیشفرض ۸ مگابایت = 8388608).
# بزرگ‌تر → رفت‌وبرگشت کمتر → آپلود سریع‌تر (ولی مصرف رم بیشتر).
RUBIKA_UPLOAD_CHUNK=8388608

# تعداد چانک‌هایی که هم‌زمان آپلود می‌شن (پیشفرض ۴).
# روی اینترنت قوی می‌تونی ۶ یا ۸ بذاری.
RUBIKA_UPLOAD_WORKERS=4

# ─── راهنمای راه‌اندازی gplaydl (نسخهٔ ۲) ──────
# بعد از نصب، یه بار این دستور رو بزن تا توکن ناشناس گرفته بشه:
#     gplaydl auth
# برای پشتیبانی از گوشی‌های ۳۲ بیتی (در حالت universal):
#     gplaydl auth --arch armv7
# (نسخهٔ ۲ نیازی به اکانت گوگل نداره و از توکن anonymous استفاده می‌کنه.)
