# ─── تلگرام ──────────────────────────────────
# از https://my.telegram.org بگیر
API_ID=your_api_id
API_HASH=your_api_hash

# از @BotFather بگیر
BOT_TOKEN=your_bot_token

# اختیاری: اگر تنظیم بشه فقط این کاربر می‌تونه ازت استفاده کنه
OWNER_TELEGRAM_ID=

# ─── روبیکا ──────────────────────────────────
# نام فایل session روبیکا (پیشفرض rubsession)
RUBIKA_SESSION=rubsession

# ─── دانلودر ─────────────────────────────────
# معماری هدف برای APK (arm64 برای اکثر گوشی‌های جدید)
PLAY_ARCH=arm64

# پوشه موقت برای فایل‌های دانلودشده
DOWNLOAD_DIR=downloads

# مسیر APKEditor.jar (اتوماتیک دانلود می‌شه اگه نبود)
APKEDITOR_JAR=tools/APKEditor.jar

# ─── راهنما ───────────────────────────────────
# بعد از نصب، یه بار این دستور رو بزن تا gplaydl تنظیم بشه:
#   gplaydl setup
# یه ایمیل گوگل و پسورد می‌خواد (برای دسترسی به گوگل پلی)
